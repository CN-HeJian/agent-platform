# 生产：**这个文件里的值都要换成真实值，并且不要提交**。
# 这里只列变量名与说明，让"生产与本地差在哪"是一眼可见的。
APLAT_HTTP_HOST=127.0.0.1
APLAT_HTTP_PORT=8787

# 必填：能执行 shell 的服务不该没有鉴权
APLAT_API_KEY=

# 必填：不设就是内存，重启全丢
APLAT_DB_URL=jdbc:mysql://db:3306/aplat
APLAT_DB_USER=
APLAT_DB_PASSWORD=

# 生产必须 ask：无人确认时宁可超时，也不能默认放行
APLAT_HITL=ask
APLAT_HITL_TIMEOUT_SEC=120

# 按角色授权（见 README 的 U25 那节）
APLAT_RBAC=

# 审计要落盘并挂持久卷：它是"谁在什么时候调了什么"的唯一凭据
APLAT_AUDIT_FILE=/app/logs/audit.jsonl

# 上游真实模型
APLAT_LLM_BASE_URL=
APLAT_LLM_API_KEY=
APLAT_LLM_MODEL=

# 要脱敏的额外环境变量（默认已含 API key / 数据库密码 / LLM key）
APLAT_SECRET_ENV=
