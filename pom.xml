<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.aplat</groupId>
  <artifactId>agent-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>agent-platform</name>
  <description>通用 Agent 平台 · 薄内核实现（Ctx 门面 + 能力缝 + append-only 会话事件日志）</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.2</junit.version>
    <mysql.version>9.2.0</mysql.version>
    <h2.version>2.4.240</h2.version>
    <jackson.version>2.17.2</jackson.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <!-- U18 持久化：MySQL 驱动。运行期才需要，编译期不依赖它的任何类型（只用 JDBC 标准 API）。 -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>${mysql.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!-- H2 只在测试与本地开发用：MySQL 兼容模式下跑同一套 SQL（见 JdbcStore 的注释） -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>${h2.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <!--
        jar 要能 `java -jar app.jar serve`：容器里没有 Maven，也没有 exec 插件。
        Main-Class 指向分发器而不是某个具体入口——同一个 jar 在本地与容器里行为一致。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.aplat.run.Main</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.2.0</version>
        <!--
          注意：<configuration> 里显式写死 mainClass 时，-Dexec.mainClass= 会被忽略
          （配置优先级高于用户属性）。所以要跑 Serve 必须用 execution 的 id：
              ./mvnw -q compile exec:java@serve
        -->
        <configuration>
          <mainClass>com.aplat.run.Demo</mainClass>
        </configuration>
        <executions>
          <execution>
            <id>demo</id>
            <configuration>
              <mainClass>com.aplat.run.Demo</mainClass>
            </configuration>
          </execution>
          <execution>
            <id>serve</id>
            <configuration>
              <mainClass>com.aplat.run.Serve</mainClass>
            </configuration>
          </execution>
          <!--
            `exec:exec@mcp-demo`：起一个 MCP 服务端子进程，走完整管线调它的工具。

            注意这里用的是 **exec 而不是 exec:java**：exec:java 在自己的 JVM 里跑，
            `java.class.path` 是 Maven 的 plexus-classworlds，**拿不到项目类路径**——
            于是"用当前 JVM 起一个子进程"这种演示会起不来（本项目就踩了这一下）。
            exec 会 fork 一个真正的 JVM，classpath 是对的。
          -->
          <execution>
            <id>mcp-demo</id>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>java</executable>
              <arguments>
                <argument>-classpath</argument>
                <classpath/>
                <argument>com.aplat.run.McpDemo</argument>
              </arguments>
            </configuration>
          </execution>
          <!-- `exec:java@crash -Dexec.args="u20 crash r1"`：真的 halt 掉进程，验证跨进程续跑 -->
          <execution>
            <id>crash</id>
            <configuration>
              <mainClass>com.aplat.run.CrashDemo</mainClass>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
