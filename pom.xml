<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.aplat</groupId>
  <artifactId>agent-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>agent-platform</name>
  <description>通用 Agent 平台 · 薄内核实现（Ctx 门面 + 能力缝 + append-only 会话事件日志）</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.2</junit.version>
    <mysql.version>9.2.0</mysql.version>
    <h2.version>2.4.240</h2.version>
    <jackson.version>2.17.2</jackson.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <!-- U18 持久化：MySQL 驱动。运行期才需要，编译期不依赖它的任何类型（只用 JDBC 标准 API）。 -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>${mysql.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!-- H2 只在测试与本地开发用：MySQL 兼容模式下跑同一套 SQL（见 JdbcStore 的注释） -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>${h2.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.2.0</version>
        <!--
          注意：<configuration> 里显式写死 mainClass 时，-Dexec.mainClass= 会被忽略
          （配置优先级高于用户属性）。所以要跑 Serve 必须用 execution 的 id：
              ./mvnw -q compile exec:java@serve
        -->
        <configuration>
          <mainClass>com.aplat.run.Demo</mainClass>
        </configuration>
        <executions>
          <execution>
            <id>demo</id>
            <configuration>
              <mainClass>com.aplat.run.Demo</mainClass>
            </configuration>
          </execution>
          <execution>
            <id>serve</id>
            <configuration>
              <mainClass>com.aplat.run.Serve</mainClass>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
