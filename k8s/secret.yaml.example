# 只列 key，不含值。**不要**把填好的版本提交进仓库。
# 用法：kubectl create secret generic aplat-secrets --from-literal=api-key=... --from-literal=rbac=...
apiVersion: v1
kind: Secret
metadata:
  name: aplat-secrets
type: Opaque
stringData:
  api-key: ""
  rbac: ""          # 形如 "alice@acme:admin:keyA;bob@acme:viewer:keyB"
  llm-api-key: ""
